# Copie para .env (nunca commitado) e preencha com valores reais antes de rodar
# `docker compose up` — tanto localmente quanto na VPS.

MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=portal
MYSQL_USER=portal_app
MYSQL_PASSWORD=troque-esta-senha-tambem

# Assina os tokens de download de artefatos (ticket #18) — string aleatória,
# pelo menos 32 caracteres. Gerar com: openssl rand -base64 32
DOWNLOAD_TOKEN_SECRET=troque-por-uma-string-aleatoria-longa-de-verdade
